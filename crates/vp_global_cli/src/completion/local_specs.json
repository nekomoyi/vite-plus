  {
    "name": "run",
    "about": "Run tasks",
    "flags": [
      {
        "long": "recursive",
        "short": "r",
        "about": "Select all packages in the workspace"
      },
      {
        "long": "transitive",
        "short": "t",
        "about": "Select the current package and its transitive dependencies"
      },
      {
        "long": "workspace-root",
        "short": "w",
        "about": "Select the workspace root package"
      },
      {
        "long": "filter",
        "short": "F",
        "about": "Match packages by name, directory, or glob pattern",
        "takes_value": true,
        "multiple": true
      },
      {
        "long": "fail-if-no-match",
        "about": "Exit with a non-zero status if a `--filter` expression matches no packages"
      },
      {
        "long": "ignore-depends-on",
        "about": "Do not run dependencies specified in `dependsOn` fields"
      },
      {
        "long": "verbose",
        "short": "v",
        "about": "Show full detailed summary after execution. A cache miss checks every input, so the summary lists every change. Twice (`-vv`), it also lists everything each cached run depends on, and its outputs",
        "multiple": true
      },
      {
        "long": "cache",
        "about": "Force caching on for all tasks and scripts"
      },
      {
        "long": "no-cache",
        "about": "Force caching off for all tasks and scripts"
      },
      {
        "long": "remote-cache",
        "about": "How the remote cache is accessed",
        "takes_value": true,
        "hidden": true,
        "value_hint": {
          "static_values": [
            ["off", "Remote caching is disabled"],
            ["read", "Cached results are downloaded"],
            [
              "read-write",
              "Cached results are downloaded and new results are uploaded after successful execution"
            ]
          ]
        }
      },
      {
        "long": "concurrency-limit",
        "about": "Maximum number of tasks to run concurrently. Defaults to 4",
        "takes_value": true
      },
      {
        "long": "parallel",
        "about": "Run tasks without dependency ordering. Sets concurrency to unlimited unless `--concurrency-limit` is also specified"
      },
      {
        "long": "log",
        "about": "How task output is displayed",
        "takes_value": true,
        "value_hint": {
          "static_values": [
            ["interleaved", "Output streams directly to the terminal as tasks produce it"],
            ["labeled", "Each line is prefixed with `[packageName#taskName]`"],
            [
              "grouped",
              "Output is buffered per task and printed as a block after each task completes"
            ]
          ]
        }
      },
      {
        "long": "dry-run",
        "about": "Show what the run would do, and whether each command would hit the cache, without running anything or writing to the cache"
      },
      {
        "long": "last-details",
        "about": "Display the detailed summary of the last run"
      },
      {
        "long": "json",
        "about": "Print JSON instead of text. Without a task, print every package and task in the workspace, and run nothing. With a task, print what the run would do, which requires `--dry-run`"
      },
      {
        "long": "help",
        "short": "h",
        "about": "Print help (see more with '--help')"
      }
    ],
    "positionals": [
      {
        "name": "task_and_args",
        "multiple": true,
        "trailing_var_arg": true
      }
    ]
  },
  {
    "name": "staged",
    "about": "Run linters on staged files using staged config from vite.config.ts.",
    "flags": [
      {
        "long": "allow-empty",
        "about": "Allow empty commits when tasks revert all staged changes"
      },
      {
        "long": "concurrent",
        "short": "p",
        "about": "Run tasks at the same time. Use false to run one task at a time",
        "optional_value": true
      },
      {
        "long": "no-concurrent",
        "about": "Run one task at a time"
      },
      {
        "long": "continue-on-error",
        "about": "Run all tasks to completion even if one fails"
      },
      {
        "long": "cwd",
        "about": "Working directory to run all tasks in",
        "takes_value": true,
        "value_hint": "dir_path"
      },
      {
        "long": "debug",
        "short": "d",
        "about": "Enable debug output"
      },
      {
        "long": "diff",
        "about": "Override the default --staged flag of git diff",
        "takes_value": true
      },
      {
        "long": "diff-filter",
        "about": "Override the default --diff-filter=ACMR flag of git diff",
        "takes_value": true
      },
      {
        "long": "fail-on-changes",
        "about": "Fail with exit code 1 when tasks modify tracked files"
      },
      {
        "long": "hide-partially-staged",
        "about": "Hide unstaged changes from partially staged files"
      },
      {
        "long": "hide-unstaged",
        "about": "Hide all unstaged changes before running tasks"
      },
      {
        "long": "no-stash",
        "about": "Disable the backup stash"
      },
      {
        "long": "quiet",
        "short": "q",
        "about": "Disable console output"
      },
      {
        "long": "relative",
        "short": "r",
        "about": "Pass filepaths relative to cwd to tasks"
      },
      {
        "long": "revert",
        "about": "Revert to original state in case of errors"
      },
      {
        "long": "verbose",
        "short": "v",
        "about": "Show task output even when tasks succeed"
      },
      {
        "long": "help",
        "short": "h",
        "about": "Show this help message"
      }
    ]
